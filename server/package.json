{
  "name": "smm-vault-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented SMM panel with a server-side SMM Vault integration.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "format": "prettier --write \"public/**/*.{html,css,js}\" \"server/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"public/**/*.{html,css,js}\" \"server/**/*.js\" \"*.{json,md}\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
